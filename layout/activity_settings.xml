<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_tieu_de_cai_dat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cài đặt"
        android:textColor="#102A43"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. Điều chỉnh âm lượng -->
    <TextView
        android:id="@+id/tv_nhan_am_luong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Âm lượng nhạc nền"
        android:textColor="#334E68"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tieu_de_cai_dat" />

    <SeekBar
        android:id="@+id/sb_am_luong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="50"
        app:layout_constraintTop_toBottomOf="@id/tv_nhan_am_luong" />

    <!-- 2. Điều chỉnh cỡ chữ -->
    <TextView
        android:id="@+id/tv_nhan_co_chu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Cỡ chữ"
        android:textColor="#334E68"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sb_am_luong" />

    <RadioGroup
        android:id="@+id/rg_co_chu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_nhan_co_chu">

        <RadioButton
            android:id="@+id/rb_chu_nho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhỏ" />

        <RadioButton
            android:id="@+id/rb_chu_vua"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Vừa" />

        <RadioButton
            android:id="@+id/rb_chu_lon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lớn" />
    </RadioGroup>

    <!-- 3. Nút đăng xuất và thoát -->
    <Button
        android:id="@+id/btn_dang_xuat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FF9800"
        android:padding="12dp"
        android:text="Đăng xuất"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btn_thoat_ung_dung" />

    <Button
        android:id="@+id/btn_thoat_ung_dung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#E94A47"
        android:padding="12dp"
        android:text="Thoát ứng dụng"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>