<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etTopicId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Topic ID"
            android:inputType="number" />

        <EditText
            android:id="@+id/etWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Từ vựng" />

        <EditText
            android:id="@+id/etPhonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phiên âm" />

        <EditText
            android:id="@+id/etPartOfSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Từ loại (n, v, adj...)" />

        <EditText
            android:id="@+id/etMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nghĩa tiếng Việt" />

        <EditText
            android:id="@+id/etExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Câu ví dụ" />

        <EditText
            android:id="@+id/etTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dịch câu ví dụ" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Lưu từ vựng" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>